# ─────────────────────────────────────────────
# LPR Client Intake — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# ── Resend (email notifications) ──────────────
# Get your key at: https://resend.com
RESEND_API_KEY=

# Where LPR intake emails are sent TO
INTAKE_NOTIFY_EMAIL=

# The "from" address (must be a verified Resend domain)
INTAKE_FROM_EMAIL=intake@yourdomain.com

# ── Telegram (instant alerts) ─────────────────
# Create a bot with @BotFather and get the token
TELEGRAM_BOT_TOKEN=

# The chat/channel ID to send alerts to
TELEGRAM_CHAT_ID_GENERAL=
